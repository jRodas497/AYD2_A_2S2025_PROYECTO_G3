digraph er {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, splines=ortho, nodesep=0.5, ranksep=0.9, bgcolor="white", label="", labelloc=t];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, fontcolor="#1F4E79", color="#6C8EBF", penwidth=1.2];

  customer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DAE8FC"><B>customer</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; customers</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">full_name : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">email : text (unique)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">phone : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tax_id : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">address : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at : timestamptz</TD></TR></TABLE>>, color="#6C8EBF"];
  product [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#D5E8D4"><B>product</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; catalog</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">sku : text (unique)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">name : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; category_id &#8594; product_category</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">price : numeric(12,2)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">active : boolean</TD></TR></TABLE>>, color="#82B366"];
  location [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFE6CC"><B>location</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; inventory</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">code : text (unique)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">name : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; type_id &#8594; location_type</I></FONT></TD></TR></TABLE>>, color="#D79B00"];
  stock [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFE6CC"><B>stock</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; inventory</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; location_id &#8594; location</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; product_id &#8594; product</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">on_hand / reserved : integer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at : timestamptz</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>PK (location_id, product_id) &#183; reserved &#8804; on_hand</I></FONT></TD></TR></TABLE>>, color="#D79B00"];
  pos_event [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFE6CC"><B>pos_event</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; integration</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; (store_id, store_type_id) &#8594; location</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>store_type_id fijo = STORE</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">event_type : text / payload : jsonb</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; status_id &#8594; delivery_status</I></FONT></TD></TR></TABLE>>, color="#D79B00"];
  app_user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F5F5F5"><B>app_user</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; config</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">username : text (unique)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">full_name / email</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">password_hash : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>rechaza texto plano</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">active / failed_attempts / locked_until</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; store_id &#8594; location (opc.)</FONT></TD></TR></TABLE>>, color="#666666"];
  erp_batch [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFE6CC"><B>erp_batch</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; integration</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">window_start / window_end</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; format_id &#8594; file_format</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; status_id &#8594; delivery_status</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">file_name : text</TD></TR></TABLE>>, color="#D79B00"];
  outbox [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFE6CC"><B>outbox</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; integration</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>aggregate_type + aggregate_id</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>(referencia polim&#243;rfica, sin FK)</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">event_type : text / payload : jsonb</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; status_id &#8594; delivery_status</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">attempts / next_attempt_at</TD></TR></TABLE>>, color="#D79B00"];
  audit_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F8CECC"><B>audit_log</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; audit</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">occurred_at : timestamptz</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">actor / action : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">entity_type / entity_id : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>order_id : bigint (sin FK, a prop&#243;sito)</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; channel_id &#8594; channel</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">details : jsonb</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>solo INSERT &#183; no UPDATE/DELETE</I></FONT></TD></TR></TABLE>>, color="#B85450"];
  setting [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F5F5F5"><B>setting</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; config</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; key : text</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">value : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">description : text</TD></TR></TABLE>>, color="#666666"];
  cart [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF2CC"><B>cart</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; orders</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; customer_id &#8594; customer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; last_channel_id &#8594; channel</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; status_id &#8594; cart_status</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at / updated_at</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>1 carrito activo por cliente</I></FONT></TD></TR></TABLE>>, color="#D6B656"];
  user_role [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F5F5F5"><B>user_role</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; config</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; user_id &#8594; app_user</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; role_id &#8594; role</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>PK (user_id, role_id)</I></FONT></TD></TR></TABLE>>, color="#666666"];
  cart_item [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF2CC"><B>cart_item</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; orders</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; cart_id &#8594; cart</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; product_id &#8594; product</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">quantity : integer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>PK (cart_id, product_id)</I></FONT></TD></TR></TABLE>>, color="#D6B656"];
  purchase_order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF2CC"><B>purchase_order</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; orders</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; cart_id &#8594; cart (unique)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; customer_id &#8594; customer</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; channel_id &#8594; channel</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; status_id &#8594; order_status</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">total : numeric(12,2) &#183; delivery_address</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at / updated_at</TD></TR></TABLE>>, color="#D6B656"];
  stock_movement [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFE6CC"><B>stock_movement</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; inventory</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; location_id &#8594; location</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; product_id &#8594; product</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; type_id &#8594; movement_type</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">quantity / reason</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; order_id &#8594; purchase_order (opc.)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at : timestamptz</TD></TR></TABLE>>, color="#D79B00"];
  order_item [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF2CC"><B>order_item</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; orders</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; order_id &#8594; purchase_order</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; product_id &#8594; product</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">quantity / unit_price</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>PK (order_id, product_id)</I></FONT></TD></TR></TABLE>>, color="#D6B656"];
  incident [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF2CC"><B>incident</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; orders</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; order_id &#8594; purchase_order</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; type_id &#8594; incident_type</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; status_id &#8594; incident_status</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">description : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at / resolved_at</TD></TR></TABLE>>, color="#D6B656"];
  payment_attempt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F8CECC"><B>payment_attempt</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; payments</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; order_id &#8594; purchase_order</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">attempt_number : integer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; result_id &#8594; payment_result</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">amount : numeric(12,2)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">provider_reference / card_last4</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">failure_reason / latency_ms</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>sin PAN ni CVV &#183; solo INSERT</I></FONT></TD></TR></TABLE>>, color="#B85450"];
  invoice [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E1D5E7"><B>invoice</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; invoicing</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; order_id &#8594; purchase_order (unique)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; status_id &#8594; invoice_status</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">cui / series : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">xml : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">sat_response : text</TD></TR></TABLE>>, color="#9673A6"];
  shipment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#B0E3E6"><B>shipment</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; logistics</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; order_id &#8594; purchase_order</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; origin_location_id &#8594; location</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; carrier_id &#8594; carrier</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; status_id &#8594; shipment_status</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tracking_number : text (unique)</TD></TR></TABLE>>, color="#0B8299"];
  notification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#D5E8D4"><B>notification</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; notifications</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; order_id &#8594; purchase_order</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; channel_id &#8594; notification_channel</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; status_id &#8594; delivery_status</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">recipient / message</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">attempts / last_error</TD></TR></TABLE>>, color="#82B366"];
  erp_batch_order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFE6CC"><B>erp_batch_order</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; integration</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; order_id &#8594; purchase_order</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; batch_id &#8594; erp_batch</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#B85450"><I>PK order_id (1 lote por orden)</I></FONT></TD></TR></TABLE>>, color="#D79B00"];
  reservation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFE6CC"><B>reservation</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; inventory</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; (order_id, product_id) &#8594; order_item</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; (location_id, product_id) &#8594; stock</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">quantity : integer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; status_id &#8594; reservation_status</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at / expires_at / closed_at</TD></TR></TABLE>>, color="#D79B00"];
  tracking_event [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#B0E3E6"><B>tracking_event</B> <FONT POINT-SIZE="10" COLOR="#666666">&#183; logistics</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>&#128273; id : bigint</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#1F4E79">&#8618; shipment_id &#8594; shipment</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#7F7F7F"><I>&#183; status_id &#8594; shipment_status</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">detail : text</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">occurred_at : timestamptz</TD></TR></TABLE>>, color="#0B8299"];

  stock -> location [dir=both, arrowtail=crow, arrowhead=tee, label="location_id"];
  stock -> product [dir=both, arrowtail=crow, arrowhead=tee, label="product_id"];
  pos_event -> location [dir=both, arrowtail=crow, arrowhead=tee, label="(store_id, store_type_id)"];
  app_user -> location [dir=both, arrowtail=crow, arrowhead=tee, label="store_id (opc.)"];
  cart -> customer [dir=both, arrowtail=crow, arrowhead=tee, label="customer_id"];
  user_role -> app_user [dir=both, arrowtail=crow, arrowhead=tee, label="user_id"];
  cart_item -> cart [dir=both, arrowtail=crow, arrowhead=tee, label="cart_id"];
  cart_item -> product [dir=both, arrowtail=crow, arrowhead=tee, label="product_id"];
  purchase_order -> cart [dir=both, arrowtail=crow, arrowhead=tee, label="cart_id"];
  purchase_order -> customer [dir=both, arrowtail=crow, arrowhead=tee, label="customer_id"];
  stock_movement -> location [dir=both, arrowtail=crow, arrowhead=tee, label="location_id"];
  stock_movement -> product [dir=both, arrowtail=crow, arrowhead=tee, label="product_id"];
  stock_movement -> purchase_order [dir=both, arrowtail=crow, arrowhead=tee, label="order_id (opc.)"];
  order_item -> purchase_order [dir=both, arrowtail=crow, arrowhead=tee, label="order_id"];
  order_item -> product [dir=both, arrowtail=crow, arrowhead=tee, label="product_id"];
  incident -> purchase_order [dir=both, arrowtail=crow, arrowhead=tee, label="order_id"];
  payment_attempt -> purchase_order [dir=both, arrowtail=crow, arrowhead=tee, label="order_id"];
  invoice -> purchase_order [dir=both, arrowtail=crow, arrowhead=tee, label="order_id"];
  shipment -> purchase_order [dir=both, arrowtail=crow, arrowhead=tee, label="order_id"];
  shipment -> location [dir=both, arrowtail=crow, arrowhead=tee, label="origin_location_id"];
  notification -> purchase_order [dir=both, arrowtail=crow, arrowhead=tee, label="order_id"];
  erp_batch_order -> purchase_order [dir=both, arrowtail=crow, arrowhead=tee, label="order_id"];
  erp_batch_order -> erp_batch [dir=both, arrowtail=crow, arrowhead=tee, label="batch_id"];
  reservation -> order_item [dir=both, arrowtail=crow, arrowhead=tee, label="(order_id, product_id)"];
  reservation -> stock [dir=both, arrowtail=crow, arrowhead=tee, label="(location_id, product_id)"];
  tracking_event -> shipment [dir=both, arrowtail=crow, arrowhead=tee, label="shipment_id"];
}