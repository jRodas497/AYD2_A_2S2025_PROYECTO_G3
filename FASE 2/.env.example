# Copiar a ".env" (no se versiona) para personalizar el stack local. Sin ".env", todo usa los
# valores por defecto de docker-compose.yml.

# Puertos en el host (no tocan los puertos reales dentro de los contenedores, solo cómo se
# publican en 127.0.0.1). Sirve para no chocar con otro proceso que ya esté usando alguno.
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=8081

# true: "./iniciar.sh" borra la base y la recrea desde FASE 2/db/migrations antes de levantar el
# stack — esquema, catálogo, los 5 clientes de demo (V9), todo desde cero. false (o sin .env):
# deja los datos como están, igual que un "docker compose up" normal. Ponerlo en true antes de
# una ronda de pruebas deja siempre el mismo punto de partida conocido.
RESET_SEED=false

# Credenciales/claves de desarrollo; cambiar en un despliegue compartido.
DB_PASSWORD=sgologic_dev
DB_APP_PASSWORD=sgologic_app_dev
JWT_SECRET=sgologic-dev-secret-cambiar-en-produccion-0123456789
CARRIER_WEBHOOK_KEY=sgologic-local-carrier-key
