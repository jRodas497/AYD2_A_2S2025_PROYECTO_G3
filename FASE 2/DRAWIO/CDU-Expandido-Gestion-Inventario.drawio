las 32 tiendas por eventos&lt;br&gt;&lt;b&gt;Código:&lt;/b&gt; GET /api/inventory/products/{id}/availability · POST /api/inventory/movements · GET /api/inventory/products/{id}/movements · InventoryReservationService · ReservationExpiryJob · ReservationLifecycleService · StockMovementController · PosEventService, PosDispatchJob&lt;br&gt;&lt;b&gt;Evidencia:&lt;/b&gt; FASE 2/pruebas/prueba_reserva_concurrente.py: 80 checkouts simultáneos, sin sobreventa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1FAEE;strokeColor=#457B9D;fontColor=#1D3557;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;" parent="1" vertex="1"><mxGeometry x="170" y="752" width="720" height="205" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>