atchService, OrderInvoicedHandler, NotificationService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1FAEE;strokeColor=#457B9D;fontColor=#1D3557;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;" parent="1" vertex="1"><mxGeometry x="170" y="852" width="710" height="215" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>