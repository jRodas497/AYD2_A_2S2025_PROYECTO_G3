<mxfile host="sgologic"><diagram name="CDU Expandido: Auditar y Consolidar" id="CDU-Expandido-Auditar-y-Consolidar"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='&lt;font style="font-size:24px"&gt;CDU Expandido: Auditar y Consolidar&lt;/font&gt;&lt;div&gt;&lt;span style="font-size:24px"&gt;RF&lt;/span&gt;&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=none;fontColor=#1D3557;" parent="1" vertex="1"><mxGeometry x="10" y="-40" width="1200" height="80" as="geometry"/></mxCell><mxCell id="boundary" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;" parent="1" vertex="1"><mxGeometry x="170" y="60" width="1050" height="622" as="geometry"/></mxCell><mxCell id="sysname" value="Sistema SGO-Logic" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=none;fontColor=#1D3557;fontSize=19;" parent="1" vertex="1"><mxGeometry x="190" y="70" width="260" height="40" as="geometry"/></mxCell><mxCell id="a_tmp" value="Temporizador (30 min)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=14;labelBackgroundColor=none;fillColor=#A8DADC;strokeColor=#457B9D;fontColor=#1D3557;" parent="1" vertex="1"><mxGeometry x="20" y="70" width="70" height="100" as="geometry"/></mxCell><mxCell id="a_fin" value="Finanzas" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=14;labelBackgroundColor=none;fillColor=#A8DADC;strokeColor=#457B9D;fontColor=#1D3557;" parent="1" vertex="1"><mxGeometry x="20" y="420" width="70" height="100" as="geometry"/></mxCell><mxCell id="a_erp" value="ERP-Core (AS/400)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineC