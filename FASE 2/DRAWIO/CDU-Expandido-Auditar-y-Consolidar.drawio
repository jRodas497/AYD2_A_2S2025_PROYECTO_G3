></mxCell><mxCell id="u_cob" value="Consultar Auditoría de Cobros" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#A8DADC;fontColor=#1D3557;strokeColor=#457B9D;labelBackgroundColor=none;fontSize=14;" parent="1" vertex="1"><mxGeometry x="230" y="430" width="250" height="72" as="geometry"/></mxCell><mxCell id="u_traz" value="Consultar Trazabilidad de una Orden" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#A8DADC;fontColor=#1D3557;strokeColor=#457B9D;labelBackgroundColor=none;fontSize=14;" parent="1" vertex="1"><mxGeometry x="230" y="560" width="250" height="72" as="geometry"/></mxCell><mxCell id="as0" value="" style="endArrow=none;html=1;rounded=0;" parent="1" source="a_tmp" target="u_sync" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as1" value="" style="endArrow=none;html=1;rounded=0;" parent="1" source="a_fin" target="u_inf" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as2" value="" style="endArrow=none;html=1;rounded=0;" parent="1" source="a_fin" target="u_cob" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as3" value="" style="endArrow=none;html=1;rounded=0;" parent="1" source="a_fin" target="u_traz" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as4" value="" style="endArrow=none;html=1;rounded=0;" parent="1" source="u_arch" target="a_erp" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r0" value="&amp;lt;&amp;lt;Include&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;" parent="1" source="u_sync" target="u_arch" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="&amp;lt;&amp;lt;Extend&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;" parent="1" source="u_rein" target="u_sync" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="&amp;lt;&amp;lt;Include&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;" parent="1" source="u_inf" target="u_conc" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="&amp;lt;&amp;lt;Extend&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;" parent="1" source="u_det" target="u_conc" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="trace" value="&lt;b&gt;Trazabilidad&lt;/b&gt;&lt;br&gt;&lt;b&gt;CDU de origen:&lt;/b&gt; CDU-07 Conciliar Ventas con ERP (CUN-07). Amplía «Consultar Registro de Auditoría» y «Generar Reporte Fiscal» de Auditoría y Trazabilidad&lt;br&gt;&lt;b&gt;Drivers:&lt;/b&gt; RF 06, RF 08 · RC 02 (auditoría de cobros en menos de 1 s), RC 07 · R 07, R 11 · ADR-0003&lt;br&gt;&lt;b&gt;Modelo de datos:&lt;/b&gt; integration.erp_batch, integration.erp_batch_order (una orden, un solo lote), vistas integration.erp_batch_summary y payments.payment_audit, audit.audit_log (solo inserción), config.setting (erp.batch_interval_minutes)&lt;br&gt;&lt;b&gt;Despliegue:&lt;/b&gt; ERP Sync Adapter y Audit / Traceability &amp; Reporting Service → contenedor sgologic-backend (paquetes integration.erp, audit); ERP-Core por CSV/XML cada 30 min (volumen erp-out)&lt;br&gt;&lt;b&gt;Código:&lt;/b&gt; ErpSyncJob, ErpBatchService, ErpDropClient · POST /api/integration/erp/batches · POST /api/integration/erp/batches/{id}/retry · GET /api/reports/sales · GET /api/reports/payments · GET /api/audit · GET /api/orders/{id}/trace&lt;br&gt;&lt;b&gt;Evidencia:&lt;/b&gt; FASE 2/pruebas/prueba_rendimiento.py: auditoría de cobros con máximo 51 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1FAEE;strokeColor=#457B9D;fontColor=#1D3557;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;" parent="1" vertex="1"><mxGeometry x="170" y="712" width="1050" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>