mxGeometry x="545" y="1030" width="200" height="70" as="geometry"/></mxCell><mxCell id="d39" value="«node»&lt;br&gt;&lt;b&gt;Proveedor de notificaciones&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=center;spacingLeft=14;spacingTop=6;fontColor=#1D3557;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="765" y="1030" width="200" height="70" as="geometry"/></mxCell><mxCell id="d40" value="«node»&lt;br&gt;&lt;b&gt;POS (32 tiendas)&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=center;spacingLeft=14;spacingTop=6;fontColor=#1D3557;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="985" y="1030" width="200" height="70" as="geometry"/></mxCell><mxCell id="d41" value="«node»&lt;br&gt;&lt;b&gt;ERP-Core (AS/400)&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=center;spacingLeft=14;spacingTop=6;fontColor=#1D3557;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="1490" y="1030" width="200" height="70" as="geometry"/></mxCell><mxCell id="d42" value="REST · circuit breaker + outbox" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#D79B00;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.0938;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="backend" target="d36" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d43" value="XML FEL" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#D79B00;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.2902;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="backend" target="d37" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d44" value="REST · circuit breaker" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#D79B00;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.4866;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="backend" target="d38" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d45" value="SMS / correo / push" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#D79B00;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.6830;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="backend" target="d39" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d46" value="eventos con reintentos" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#D79B00;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.8795;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="backend" target="d40" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d47" value="recoge CSV/XML cada 30 min" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#D79B00;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="d27" target="d41" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d48" value="Los adaptadores de &lt;code&gt;external&lt;/code&gt; son el único punto de salida hacia cada tercero." style="text;html=1;whiteSpace=wrap;rounded=0;fontColor=#1D3557;fontSize=11;fontStyle=2;" parent="1" vertex="1"><mxGeometry x="110" y="1105" width="900" height="24" as="geometry"/></mxCell><mxCell id="d49" value="&lt;b&gt;Correspondencia con la vista objetivo&lt;/b&gt; (Diagrama-Despliegue-SGO-Logic-Fase2)&lt;br&gt;• 5 hosts con un contenedor por componente → &lt;b&gt;1 host, 2 contenedores&lt;/b&gt;: los componentes son módulos del mismo proceso para que el checkout cree la orden y reserve el stock en una sola transacción (ADR-0009). El ADR-0001 pedía contenedores independientes; separarlos es la evolución prevista en el ADR-0005.&lt;br&gt;• Message Broker (RabbitMQ) en host propio → &lt;b&gt;tabla integration.outbox + OutboxDispatcher&lt;/b&gt; dentro de la base y del backend (ADR-0007).&lt;br&gt;• API Gateway / BFF Omnicanal → &lt;b&gt;no implementado en el MVP&lt;/b&gt; (ADR-0009): los canales llaman directo al backend en :8080.&lt;br&gt;• Pricing &amp;amp; Promotions Service → &lt;b&gt;no implementado en el MVP&lt;/b&gt; (ADR-0009): el precio sale de catalog.product y se congela en order_item al hacer checkout.&lt;br&gt;• PayKlik, SAT, LogiExpress, mensajería, POS y la carpeta del AS/400 → &lt;b&gt;simulados&lt;/b&gt; detrás de los adaptadores de &lt;code&gt;external&lt;/code&gt;, conmutables desde /api/simulation (ADR-0008)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1FAEE;strokeColor=#457B9D;fontColor=#1D3557;fontSize=12;align=left;verticalAlign=top;spacing=10;arcSize=3;" parent="1" vertex="1"><mxGeometry x="40" y="1140" width="1720" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>