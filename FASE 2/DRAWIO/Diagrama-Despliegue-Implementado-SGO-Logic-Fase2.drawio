<mxfile host="sgologic"><diagram name="Despliegue implementado (MVP)" id="despliegue-mvp"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1290" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d1" value='&lt;font style="font-size:26px"&gt;&lt;b&gt;Diagrama de Despliegue Implementado — SGO-Logic (MVP Fase 2)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px"&gt;Lo que levanta hoy &lt;code&gt;docker compose up&lt;/code&gt; desde &lt;code&gt;FASE 2/docker-compose.yml&lt;/code&gt;. La vista objetivo con cinco hosts está en &lt;i&gt;Diagrama-Despliegue-SGO-Logic-Fase2&lt;/i&gt;.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;rounded=0;fontColor=#1D3557;" parent="1" vertex="1"><mxGeometry x="40" y="0" width="1700" height="70" as="geometry"/></mxCell><mxCell id="d2" value="«device»&lt;br&gt;&lt;b&gt;Web&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=center;spacingLeft=14;spacingTop=6;fontColor=#1D3557;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1"><mxGeometry x="120" y="90" width="260" height="70" as="geometry"/></mxCell><mxCell id="d3" value="«device»&lt;br&gt;&lt;b&gt;App móvil&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=center;spacingLeft=14;spacingTop=6;fontColor=#1D3557;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1"><mxGeometry x="440" y="90" width="260" height="70" as="geometry"/></mxCell><mxCell id="d4" value="«device»&lt;br&gt;&lt;b&gt;Terminal de tienda&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=center;spacingLeft=14