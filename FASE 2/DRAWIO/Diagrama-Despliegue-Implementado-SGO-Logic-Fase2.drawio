;br&gt;&lt;font style='font-size:11px'&gt;imagen fase2-backend · Java 21 + Spring Boot 3.3 · puerto 8080 · un contenedor de aplicación con un módulo por componente (ADR-0009)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontColor=#1D3557;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="100" y="310" width="1120" height="620" as="geometry"/></mxCell><mxCell id="d9" value="&lt;b&gt;Núcleo comercial&lt;/b&gt; (Backend 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontColor=#1D3557;fontSize=12;arcSize=3;strokeColor=#82B366;" parent="1" vertex="1"><mxGeometry x="120" y="370" width="1080" height="130" as="geometry"/></mxCell><mxCell id="d10" value="&lt;b&gt;Catalog / Product Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;catalog&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1"><mxGeometry x="135" y="405" width="200" height="75" as="geometry"/></mxCell><mxCell id="d11" value="&lt;b&gt;Customer Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;customers&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1"><mxGeometry x="348" y="405" width="200" height="75" as="geometry"/></mxCell><mxCell id="d12" value="&lt;b&gt;Inventory Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;inventory&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1"><mxGeometry x="561" y="405" width="200" height="75" as="geometry"/></mxCell><mxCell id="d13" value="&lt;b&gt;Order / Checkout Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;orders&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1"><mxGeometry x="774" y="405" width="200" height="75" as="geometry"/></mxCell><mxCell id="d14" value="&lt;b&gt;Identity / Configuration&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;config&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1"><mxGeometry x="987" y="405" width="200" height="75" as="geometry"/></mxCell><mxCell id="d15" value="&lt;b&gt;Transacciones e integraciones&lt;/b&gt; (Backend 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontColor=#1D3557;fontSize=12;arcSize=3;strokeColor=#D79B00;" parent="1" vertex="1"><mxGeometry x="120" y="515" width="1080" height="260" as="geometry"/></mxCell><mxCell id="d16" value="&lt;b&gt;Payment Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;payments&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="135" y="550" width="200" height="80" as="geometry"/></mxCell><mxCell id="d17" value="&lt;b&gt;Invoicing Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;invoicing&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="348" y="550" width="200" height="80" as="geometry"/></mxCell><mxCell id="d18" value="&lt;b&gt;Logistics Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;logistics&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="561" y="550" width="200" height="80" as="geometry"/></mxCell><mxCell id="d19" value="&lt;b&gt;Notification Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;notifications&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="774" y="550" width="200" height="80" as="geometry"/></mxCell><mxCell id="d20" value="&lt;b&gt;Audit / Traceability &amp;amp; Reporting&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;audit&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="987" y="550" width="200" height="80" as="geometry"/></mxCell><mxCell id="d21" value="&lt;b&gt;ERP Sync Adapter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;integration.erp&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="135" y="660" width="255" height="80" as="geometry"/></mxCell><mxCell id="d22" value="&lt;b&gt;POS Adapter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;integration.pos&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="403" y="660" width="255" height="80" as="geometry"/></mxCell><mxCell id="d23" value="&lt;b&gt;Message Broker: outbox + repartidor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;integration (ADR-0007)&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;" parent="1" vertex="1"><mxGeometry x="671" y="660" width="255" height="80" as="geometry"/></mxCell><mxCell id="d24" value="&lt;b&gt;Adaptadores de terceros&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete &lt;code&gt;external (ADR-0008)&lt;/code&gt;&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="939" y="660" width="255" height="80" as="geometry"/></mxCell><mxCell id="d25" value="&lt;b&gt;Tareas programadas dentro del mismo proceso&lt;/b&gt; (@Scheduled, pool de 5 hilos)&lt;br&gt;ReservationExpiryJob cada 30 s (libera reservas vencidas, TTL en config.setting) · OutboxDispatcher cada 2 s (broker) · NotificationDispatchJob cada 5 s · PosDispatchJob cada 5 s · ErpSyncJob cada 60 s (cierra la ventana de 30 min, reintenta lotes pendientes y manda la existencia consolidada a las 32 tiendas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#6C8EBF;fontColor=#1D3557;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1"><mxGeometry x="120" y="790" width="1080" height="120" as="geometry"/></mxCell><mxCell id="db" value="«artifact» &lt;b&gt;sgologic-db&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;postgres:16-alpine · 127.0.0.1:5432&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left;font-size:11px'&gt;Una base, un esquema por componente (ADR-0001):&lt;br&gt;• config · catalog · customers&lt;br&gt;• inventory · orders&lt;br&gt;• payments (payment_attempt solo inserción)&lt;br&gt;• invoicing · logistics · notifications&lt;br&gt;• &lt;b&gt;integration&lt;/b&gt;: outbox (= broker), pos_event, erp_batch&lt;br&gt;• audit (audit_log solo inserción)&lt;br&gt;&lt;br&gt;Migraciones V1–V8 al primer arranque.&lt;br&gt;La app entra con el rol &lt;b&gt;sgologic_app&lt;/b&gt;,&lt;br&gt;sin superusuario (ADR-0006).&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontColor=#1D3557;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;" parent="1" vertex="1"><mxGeometry x="1260" y="310" width="440" height="330" as="geometry"/></mxCell><mxCell id="d26" value="«volume»&lt;br&gt;&lt;b&gt;db_data&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1D3557;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1290" y="690" width="170" height="110" as="geometry"/></mxCell><mxCell id="d27" value="«bind mount»&lt;br&gt;&lt;b&gt;./erp-out → /app/erp-out&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;archivos CSV/XML para el AS/400&lt;/font&gt;" style="shape=folder;whiteSpace=wrap;html=1;tabWidth=60;tabHeight=14;tabPosition=left;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1D3557;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1470" y="820" width="240" height="100" as="geometry"/></mxCell><mxCell id="d28" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;" parent="1" source="d2" target="backend" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d29" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;" parent="1" source="d3" target="backend" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d30" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;" parent="1" source="d4" target="backend" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d31" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;" parent="1" source="d5" target="backend" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d32" value="" style="endArrow=block;html=