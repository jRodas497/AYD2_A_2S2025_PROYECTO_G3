<mxfile host="sgologic"><diagram name="Componentes implementados (MVP)" id="componentes-mvp"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1830" pageHeight="1140" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;font style="font-size:26px"&gt;&lt;b&gt;Diagrama de Componentes Implementado — SGO-Logic (MVP Fase 2)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px"&gt;Los componentes tal como existen en &lt;code&gt;FASE 2/backend&lt;/code&gt;: un paquete por componente, un esquema por componente. La vista objetivo está en &lt;i&gt;Diagrama-Componentes-SGO-Logic-Fase2&lt;/i&gt;.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;rounded=0;fontColor=#1D3557;" parent="1" vertex="1"><mxGeometry x="40" y="0" width="1750" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Canales omnicanal&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;web · app móvil · terminal de tienda · centro de atención · backoffice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1D3557;fontSize=13;" parent="1" vertex="1"><mxGeometry x="560" y="85" width="600" height="60" as="geometry"/></mxCell><mxCell id="c3" value="SGO-Logic — límite del sistema (contenedor &lt;b&gt;sgologic-backend&lt;/b&gt; + &lt;b&gt;sgologic-db&lt;/b&gt;)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;fontColor=#1D3557;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40" y="180" width="1750" height="650" as="geometry"/></mxCell><mxCell id="c4" value="REST / JSON · :8080 (sin API Gateway en el MVP)" style="endArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" source="c2" target="c3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" value="«component»&lt;br&gt;&lt;b&gt;Identity / Configuration&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete config · config.setting&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1"><mxGeometry x="60" y="225" width="240" height="90" as="geometry"/></mxCell><mxCell id="c6" value="«component»&lt;br&gt;&lt;b&gt;Customer Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete customers · historial&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1"><mxGeometry x="330" y="225" width="240" height="90" as="geometry"/></mxCell><mxCell id="c7" value="«component»&lt;br&gt;&lt;b&gt;Catalog / Product Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete catalog&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1"><mxGeometry x="600" y="225" width="240" height="90" as="geometry"/></mxCell><mxCell id="c8" value="«component»&lt;br&gt;&lt;b&gt;Order / Checkout Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete orders · carrito, checkout,&lt;br&gt;consulta, incidencias&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1"><mxGeometry x="870" y="225" width="240" height="90" as="geometry"/></mxCell><mxCell id="c9" value="«component»&lt;br&gt;&lt;b&gt;Inventory Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete inventory · reserva atómica,&lt;br&gt;TTL, movimientos&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1"><mxGeometry x="1140" y="225" width="240" height="90" as="geometry"/></mxCell><mxCell id="c10" value="precio" style="endArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" source="c8" target="c7" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="reserva stock" style="endArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" source="c8" target="c9" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="broker" value="«component» &lt;b&gt;Message Broker&lt;/b&gt; · &lt;code&gt;integration.outbox&lt;/code&gt; + &lt;code&gt;OutboxDispatcher&lt;/code&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;sondeo cada 2 s · reintentos con espera creciente · ADR-0007&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1D3557;fontSize=12;align=left;spacingLeft=14;" parent="1" vertex="1"><mxGeometry x="60" y="395" width="1320" height="55" as="geometry"/></mxCell><mxCell id="c12" value="«component»&lt;br&gt;&lt;b&gt;Payment Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete payments · outbox +&lt;br&gt;circuit breaker (ADR-0002)&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="60" y="540" width="240" height="90" as="geometry"/></mxCell><mxCell id="c13" value="«component»&lt;br&gt;&lt;b&gt;Invoicing Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete invoicing · XML con CUI y serie&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="330" y="540" width="240" height="90" as="geometry"/></mxCell><mxCell id="c14" value="«component»&lt;br&gt;&lt;b&gt;Logistics Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete logistics · origen, guía, rastreo&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="600" y="540" width="240" height="90" as="geometry"/></mxCell><mxCell id="c15" value="«component»&lt;br&gt;&lt;b&gt;Notification Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete notifications · «transversal»&lt;br&gt;best-effort (ADR-0004)&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="870" y="540" width="240" height="90" as="geometry"/></mxCell><mxCell id="c16" value="«component»&lt;br&gt;&lt;b&gt;Audit / Traceability &amp;amp; Reporting&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete audit · «transversal»&lt;br&gt;solo inserción, reportes&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="1140" y="540" width="240" height="90" as="geometry"/></mxCell><mxCell id="c17" value="«component»&lt;br&gt;&lt;b&gt;POS Adapter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete integration.pos · reintentos&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="1510" y="720" width="240" height="90" as="geometry"/></mxCell><mxCell id="c18" value="«component»&lt;br&gt;&lt;b&gt;ERP Sync Adapter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;paquete integration.erp · CSV/XML&lt;br&gt;cada 30 min, idempotente&lt;/font&gt;" style="shape=component;align=center;whiteSpace=wrap;html=1;fontColor=#1D3557;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="1140" y="720" width="240" height="90" as="geometry"/></mxCell><mxCell id="c19" value="publica&lt;br&gt;OrderPaid" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#D79B00;strokeWidth=2;fontColor=#8A5A00;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;entryX=0.07;entryY=1;" parent="1" source="c12" target="broker" edge="1"><mxGeometry x="0.45" relative="1" as="geometry"/></mxCell><mxCell id="c20" value="reintento:&lt;br&gt;PaymentRetryRequested" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#D79B00;strokeWidth=2;fontColor=#8A5A00;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.14;exitY=1;entryX=0.8;entryY=0;" parent="1" source="broker" target="c12" edge="1"><mxGeometry x="-0.2" relative="1" as="geometry"/></mxCell><mxCell id="c21" value="OrderPaid" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#D79B00;strokeWidth=2;fontColor=#8A5A00;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.4;entryY=0;" parent="1" source="broker" target="c13" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="publica OrderInvoiced" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#D79B00;strokeWidth=2;fontColor=#8A5A00;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=0;entryX=0.46;entryY=1;" parent="1" source="c13" target="broker" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="OrderInvoiced" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#D79B00;strokeWidth=2;fontColor=#8A5A00;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.55;exitY=1;entryX=0.5;entryY=0;" parent="1" source="broker" target="c14" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="confirma la reserva" style="endArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0.2;entryY=1;" parent="1" source="c12" target="c9" edge="1"><mxGeometry x="0.72" relative="1" as="geometry"/></mxCell><mxCell id="c25" value="consume / mueve stock" style="endArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=0;entryX=0.5;entryY=1;" parent="1" source="c14" target="c9" edge="1"><mxGeometry x="0.6" relative="1" as="geometry"/></mxCell><mxCell id="c26" value="eventos de existencia (tiendas)" style="endArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=0.6;entryY=0;" parent="1" source="c9" target="c17" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="paso 10: existencia&lt;br&gt;consolidada" style="endArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="c18" target="c17" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="«component» &lt;b&gt;Base de datos compartida&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;PostgreSQL 16 · un esquema por componente (ADR-0001)&lt;br&gt;rol sgologic_app sin superusuario (ADR-0006)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1D3557;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1450" y="215" width="320" height="150" as="geometry"/></mxCell><mxCell id="c29" value="la cola vive en la base" style="endArrow=open;dashed=1;dashPattern=1 3;html=1;rounded=0;strokeColor=#9673A6;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0.3;entryY=1;" parent="1" source="broker" target="c28" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;PayKlik&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;simulado tras &lt;code&gt;external&lt;/code&gt; (ADR-0008)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1D3557;fontSize=12;" parent="1" vertex="1"><mxGeometry x="60" y="890" width="240" height="65" as="geometry"/></mxCell><mxCell id="c31" value="REST" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#B8860B;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="c12" target="c30" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;SAT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;simulado tras &lt;code&gt;external&lt;/code&gt; (ADR-0008)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1D3557;fontSize=12;" parent="1" vertex="1"><mxGeometry x="330" y="890" width="240" height="65" as="geometry"/></mxCell><mxCell id="c33" value="XML FEL" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#B8860B;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="c13" target="c32" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;LogiExpress&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;simulado tras &lt;code&gt;external&lt;/code&gt; (ADR-0008)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1D3557;fontSize=12;" parent="1" vertex="1"><mxGeometry x="600" y="890" width="240" height="65" as="geometry"/></mxCell><mxCell id="c35" value="REST" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#B8860B;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="c14" target="c34" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Proveedor de notificaciones&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;simulado tras &lt;code&gt;external&lt;/code&gt; (ADR-0008)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1D3557;fontSize=12;" parent="1" vertex="1"><mxGeometry x="870" y="890" width="240" height="65" as="geometry"/></mxCell><mxCell id="c37" value="SMS / correo / push" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#B8860B;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="c15" target="c36" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;ERP-Core (AS/400)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;simulado tras &lt;code&gt;external&lt;/code&gt; (ADR-0008)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1D3557;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1140" y="890" width="240" height="65" as="geometry"/></mxCell><mxCell id="c39" value="CSV/XML · volumen erp-out" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#B8860B;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="c18" target="c38" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;POS (32 tiendas)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;simulado tras &lt;code&gt;external&lt;/code&gt; (ADR-0008)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1D3557;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1510" y="890" width="240" height="65" as="geometry"/></mxCell><mxCell id="c41" value="eventos" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#B8860B;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="c17" target="c40" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Línea continua:&lt;/b&gt; llamada directa dentro de la misma transacción (reservar stock, confirmar la reserva, bajar existencia).&lt;br&gt;• &lt;b&gt;Línea naranja con nombre:&lt;/b&gt; evento que viaja por el outbox. Pago, facturación y despacho no se llaman entre sí: cada paso publica un evento y el broker se lo entrega al siguiente, con reintentos. Por eso una caída de PayKlik, la SAT o LogiExpress no tumba el paso anterior.&lt;br&gt;• &lt;b&gt;«transversal»:&lt;/b&gt; todos los componentes registran en Audit / Traceability y encolan avisos en Notification Service dentro de su propia transacción; esas flechas se omiten para no saturar el diagrama.&lt;br&gt;• &lt;b&gt;Respecto de la vista objetivo:&lt;/b&gt; el Message Broker es la tabla &lt;code&gt;integration.outbox&lt;/code&gt;, no RabbitMQ (ADR-0007); API Gateway / BFF y Pricing &amp;amp; Promotions no están implementados en el MVP, y los componentes comparten un contenedor para que el checkout sea atómico (ADR-0009)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1FAEE;strokeColor=#457B9D;fontColor=#1D3557;fontSize=12;align=left;verticalAlign=top;spacing=10;arcSize=3;" parent="1" vertex="1"><mxGeometry x="40" y="990" width="1750" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>