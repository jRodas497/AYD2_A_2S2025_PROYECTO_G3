<mxfile host="sgologic"><diagram name="Bloques implementado (MVP)" id="bloques-mvp"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="980" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value='&lt;font style="font-size:24px"&gt;&lt;b&gt;Sistema de Gestión de Órdenes y Logística Omnicanal (SGO-Logic)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:14px"&gt;Diagrama de bloques implementado — MVP Fase 2&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1"><mxGeometry x="290" y="10" width="1180" height="75" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Canales de acceso&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#F3EEFA;strokeColor=#9673A6;fontSize=15;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="20" y="120" width="230" height="560" as="geometry"/></mxCell><mxCell id="b3" value="Aplicación móvil" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40" y="170" width="190" height="80" as="geometry"/></mxCell><mxCell id="b4" value="Sitio web" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40" y="270" width="190" height="80" as="geometry"/></mxCell><mxCell id="b5" value="Centro de atención telefónica (agentes)" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40" y="370" width="190" height="80" as="geometry"/></mxCell><mxCell id="b6" value="Terminal de tienda (32 tiendas)" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40" y="470" width="190" height="80" as="geometry"/></mxCell><mxCell id="b7" value="Backoffice: logística, Finanzas, administración" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40" y="570" width="190" height="80" as="geometry"/></mxCell><mxCell id="plat" value="&lt;b&gt;Servidor on-premises · Docker Compose&lt;/b&gt; (ADR-0005) — contenedor &lt;b&gt;sgologic-backend&lt;/b&gt;: un contenedor de aplicación con un módulo por componente (ADR-0009)" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=none;strokeColor=#6C8EBF;dashed=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;" parent="1" vertex="1"><mxGeometry x="290" y="120" width="1180" height="760" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;API REST&lt;/b&gt; · Spring Boot 3.3 · JSON en :8080 · validación y formato de error uniforme (sin API Gateway en el MVP, ADR-0009)" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#E1ECF7;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1"><mxGeometry x="310" y="165" width="1140" height="45" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;Núcleo comercial&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=none;strokeColor=#82B366;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;" parent="1" vertex="1"><mxGeometry x="310" y="225" width="1140" height="160" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;Órdenes y carrito&lt;/b&gt;&lt;div style='text-align:left;font-size:11px;margin-top:4px'&gt;• Carrito único entre canales&lt;br&gt;• Checkout y reserva de stock&lt;br&gt;• Incidencias: cambios y devoluciones&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="325" y="255" width="270" height="112" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;Inventario&lt;/b&gt;&lt;div style='text-align:left;font-size:11px;margin-top:4px'&gt;• Vista unificada 2 CD + 32 tiendas&lt;br&gt;• Reserva atómica y liberación por TTL&lt;br&gt;• Entradas y salidas de mercancía&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="608" y="255" width="270" height="112" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;Catálogo y clientes&lt;/b&gt;&lt;div style='text-align:left;font-size:11px;margin-top:4px'&gt;• Productos y precio vigente&lt;br&gt;• Clientes e historial&lt;br&gt;• Parámetros (config.setting)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="891" y="255" width="270" height="112" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;Consulta de orden&lt;/b&gt;&lt;div style='text-align:left;font-size:11px;margin-top:4px'&gt;• Estado, despacho y entrega en una fila&lt;br&gt;• Trazabilidad completa de la orden&lt;br&gt;• &lt; 5 s (medido: 51 ms)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1174" y="255" width="262" height="112" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;Transacciones e integraciones&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=none;strokeColor=#D6B656;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;" parent="1" vertex="1"><mxGeometry x="310" y="400" width="1140" height="300" as="geometry"/></mxCell><mxCell id="b15" value="&lt;b&gt;Pagos&lt;/b&gt;&lt;div style='text-align:left;font-size:11px;margin-top:4px'&gt;• Cobro con PayKlik&lt;br&gt;• Outbox + circuit breaker&lt;br&gt;• Sin PAN ni CVV&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="325" y="430" width="270" height="112" as="geometry"/></mxCell><mxCell id="b16" value="&lt;b&gt;Facturación&lt;/b&gt;&lt;div style='text-align:left;font-size:11px;margin-top:4px'&gt;• XML con CUI y serie&lt;br&gt;• Envío asíncrono a la SAT&lt;br&gt;• No se despacha sin factura&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="608" y="430" width="270" height="112" as="geometry"/></mxCell><mxCell id="b17" value="&lt;b&gt;Despacho logístico&lt;/b&gt;&lt;div style='text-align:left;font-size:11px;margin-top:4px'&gt;• Punto de despacho óptimo&lt;br&gt;• Guía con LogiExpress&lt;br&gt;• Rastreo y cambio de origen&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="891" y="430" width="270" height="112" as="geometry"/></mxCell><mxCell id="b18" value="&lt;b&gt;Notificaciones&lt;/b&gt;&lt;div style='text-align:left;font-size:11px;margin-top:4px'&gt;• SMS / correo / push&lt;br&gt;• Cola propia, best-effort&lt;br&gt;• No bloquea la orden&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1174" y="430" width="262" height="112" as="geometry"/></mxCell><mxCell id="b19" value="&lt;b&gt;Integración con legados&lt;/b&gt;&lt;div style='text-align:left;font-size:11px;margin-top:4px'&gt;• AS/400: CSV/XML cada 30 min&lt;br&gt;• POS: existencia consolidada por ventana&lt;br&gt;• Reintentos, idempotente&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="325" y="565" width="270" height="112" as="geometry"/></mxCell><mxCell id="b20" value="&lt;b&gt;Auditoría y reportes&lt;/b&gt;&lt;div style='text-align:left;font-size:11px;margin-top:4px'&gt;• Registro de solo inserción&lt;br&gt;• Informe de ventas conciliado&lt;br&gt;• Cobros para Finanzas &lt; 1 s&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="608" y="565" width="270" height="112" as="geometry"/></mxCell><mxCell id="b21" value="&lt;b&gt;Bus de eventos: Transactional Outbox&lt;/b&gt;&lt;div style='font-size:11px;margin-top:4px'&gt;tabla integration.outbox + repartidor cada 2 s&lt;br&gt;OrderPaid → OrderInvoiced → despacho&lt;br&gt;reintentos con espera creciente (ADR-0007)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="891" y="565" width="545" height="112" as="geometry"/></mxCell><mxCell id="b22" value="&lt;b&gt;Capa de datos&lt;/b&gt; — contenedor &lt;b&gt;sgologic-db&lt;/b&gt; · PostgreSQL 16 · &lt;b&gt;una base, un esquema por componente&lt;/b&gt; (ADR-0001) · volumen persistente db_data&lt;br&gt;&lt;font style='font-size:11px'&gt;config · catalog · customers · inventory · orders · payments · invoicing · logistics · notifications · integration · audit — rol de aplicación sin superusuario (ADR-0006)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" parent="1" vertex="1"><mxGeometry x="310" y="715" width="1140" height="70" as="geometry"/></mxCell><mxCell id="b23" value="&lt;b&gt;Carpeta de intercambio&lt;/b&gt; ./erp-out — archivos para el AS/400" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" parent="1" vertex="1"><mxGeometry x="310" y="800" width="560" height="55" as="geometry"/></mxCell><mxCell id="b24" value="&lt;b&gt;Tareas programadas&lt;/b&gt;: liberar reservas, repartir eventos, enviar avisos, entregar al POS, cerrar la ventana del ERP" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#EEF2F7;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1"><mxGeometry x="890" y="800" width="560" height="55" as="geometry"/></mxCell><mxCell id="b25" value="&lt;b&gt;Integraciones externas y sistemas legados&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#F1FAEE;strokeColor=#82B366;fontSize=15;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1510" y="120" width="270" height="560" as="geometry"/></mxCell><mxCell id="b26" value="&lt;b&gt;PayKlik&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;pagos · REST&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1530" y="165" width="230" height="70" as="geometry"/></mxCell><mxCell id="b27" value="&lt;b&gt;SAT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;facturación electrónica · XML&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1530" y="249" width="230" height="70" as="geometry"/></mxCell><mxCell id="b28" value="&lt;b&gt;LogiExpress&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;guías y rastreo · REST&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1530" y="333" width="230" height="70" as="geometry"/></mxCell><mxCell id="b29" value="&lt;b&gt;Proveedor de mensajería&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;SMS / correo / push&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1530" y="417" width="230" height="70" as="geometry"/></mxCell><mxCell id="b30" value="&lt;b&gt;ERP-Core AS/400&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;CSV/XML cada 30 min · no se modifica&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1530" y="501" width="230" height="70" as="geometry"/></mxCell><mxCell id="b31" value="&lt;b&gt;POS de 32 tiendas&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;eventos · no se modifica&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1530" y="585" width="230" height="70" as="geometry"/></mxCell><mxCell id="b32" value="En el MVP los seis se simulan detrás de un adaptador (ADR-0008)" style="text;html=1;whiteSpace=wrap;fontColor=#1D3557;fontSize=11;fontStyle=2;" parent="1" vertex="1"><mxGeometry x="1520" y="675" width="250" height="40" as="geometry"/></mxCell><mxCell id="b33" value="HTTPS · REST/JSON" style="endArrow=block;startArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" source="b2" target="plat" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b34" value="" style="endArrow=block;startArrow=block;html=1;rounded=0;strokeColor=#1D3557;fontColor=#1D3557;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" source="plat" target="b25" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b35" value="&lt;b&gt;Estilo arquitectónico&lt;/b&gt; (ADR-0001)&lt;br&gt;Monolítico (en el MVP, un contenedor de aplicación: ADR-0009), integración asíncrona por eventos (outbox, ADR-0007) y orientado a datos (base compartida con esquemas por componente).&lt;br&gt;&lt;br&gt;&lt;b&gt;Drivers principales&lt;/b&gt;&lt;br&gt;• Disponibilidad ante fallas de terceros (DC-01, DC-06)&lt;br&gt;• Consistencia del inventario (RC08)&lt;br&gt;• Auditabilidad y seguridad de pago (DC-07, DC-08)" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#F3EEFA;strokeColor=#9673A6;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1510" y="720" width="270" height="210" as="geometry"/></mxCell><mxCell id="b36" value="&lt;b&gt;Evolución prevista&lt;/b&gt; (ADR-0005): separar módulos en contenedores propios, broker dedicado y API Gateway cuando el volumen lo justifique. La vista de referencia con microservicios, nube y Kubernetes va más allá incluso de esa meta: el ADR-0001 los descartó." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#1D3557;arcSize=6;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="20" y="900" width="1450" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>