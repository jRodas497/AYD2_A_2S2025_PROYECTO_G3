="" style="endArrow=none;html=1;rounded=0;" parent="1" source="a_fin" target="u_emit" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as4" value="" style="endArrow=none;html=1;rounded=0;" parent="1" source="u_pagar" target="a_pk" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as5" value="" style="endArrow=none;html=1;rounded=0;" parent="1" source="u_rein" target="a_pk" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as6" value="" style="endArrow=none;html=1;rounded=0;" parent="1" source="u_env" target="a_sat" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r0" value="&amp;lt;&amp;lt;Include&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;" parent="1" source="u_pagar" target="u_reg" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="&amp;lt;&amp;lt;Include&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;" parent="1" source="u_pagar" target="u_tok" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="&amp;lt;&amp;lt;Extend&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;" parent="1" source="u_rein" target="u_pagar" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="&amp;lt;&amp;lt;Include&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;" parent="1" source="u_rein" target="u_cola" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="&amp;lt;&amp;lt;Include&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;" parent="1" source="u_emit" target="u_xml" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5" value="&amp;lt;&amp;lt;Include&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;" parent="1" source="u_emit" target="u_env" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r6" value="&amp;lt;&amp;lt;Extend&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=12;" parent="1" source="u_esc" target="u_emit" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="trace" value="&lt;b&gt;Trazabilidad&lt;/b&gt;&lt;br&gt;&lt;b&gt;CDU de origen:&lt;/b&gt; CDU-02 Procesar Pago (CUN-02) y CDU-03 Emitir Documentación Fiscal (CUN-03). Amplía «Realizar Pago» y «Generar Comprobante» de Realizar Compra&lt;br&gt;&lt;b&gt;Drivers:&lt;/b&gt; RF 05, RF 06, RF 07 · RC 04, RC 05, RC 06, RC 07, RC 09 · ADR-0002, ADR-0007, ADR-0008&lt;br&gt;&lt;b&gt;Modelo de datos:&lt;/b&gt; payments.payment_attempt (solo inserción; sin columnas de PAN ni CVV), vista payments.payment_audit, invoicing.invoice (order_id único; cui, series, xml, sat_response), integration.outbox, audit.audit_log&lt;br&gt;&lt;b&gt;Despliegue:&lt;/b&gt; Payment Service, Invoicing Service y Message Broker (outbox) → contenedor sgologic-backend (paquetes payments, invoicing, integration); PayKlik por REST, SAT por XML&lt;br&gt;&lt;b&gt;Código:&lt;/b&gt; POST y GET /api/orders/{id}/payments · GET y POST /api/orders/{id}/invoice · GET /api/orders/{id}/invoice/xml — PaymentService, PaymentRetryHandler, CardDataGuard, InvoicingService, OrderPaidHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1FAEE;strokeColor=#457B9D;fontColor=#1D3557;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=4;" parent="1" vertex="1"><mxGeometry x="170" y="772" width="1050" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>